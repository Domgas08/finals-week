@page "/decks/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using FinalsWeek.Core
@using FinalsWeek.Application
@inject CurrentUser CurrentUser
@inject IDeckStore DeckStore
@inject NavigationManager Navigation

<PageTitle>Create deck</PageTitle>

<h1>Create deck</h1>

<EditForm Model="@form" OnSubmit="@SubmitForm">
    <div class="mb-3">
        <label class="form-label">Title</label>
        <InputText class="form-control" @bind-Value="form.Title" />

        @if (error is not null)
        {
            <div class="text-danger">@error</div>
        }
    </div>

    <div class="mb-3">
        <label class="form-label">Course code</label>
        <InputText class="form-control" @bind-Value="form.CourseCode" />
    </div>

    <div class="mb-3">
        <label class="form-label">Description</label>
        <InputTextArea class="form-control" @bind-Value="form.Description" />
    </div>

    <div class="mb-3">
        <label class="form-label">Visibility</label>
        <InputSelect class="form-select" @bind-Value="form.Visibility">
            <option value="@Visibility.Private">Private</option>
            <option value="@Visibility.Public">Public</option>
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary" disabled="@saving">
        @(saving ? "Creating..." : "Create")
    </button>

    <a class="ms-2" href="/decks">Cancel</a>
</EditForm>

@code {
    private CreateDeckForm form = new();
    private string? error;
    private bool saving;

    private string? userId;

    private async Task SubmitForm()
    {
        if (saving)
        {
            return;
        }

        error = null;
        saving = true;

        try
        {
            userId = await CurrentUser.GetIdAsync();

            var deck = new Deck(
                form.Title,
                courseCode: Normalise(form.CourseCode),
                description: Normalise(form.Description),
                visibility: form.Visibility);

            ArgumentException.ThrowIfNullOrWhiteSpace(userId);
            await DeckStore.AddAsync(deck, userId);
            Navigation.NavigateTo("/decks");
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
            saving = false;
        }
    }

    private static string? Normalise(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private class CreateDeckForm
    {
        public string Title { get; set; } = string.Empty;

        public string? CourseCode { get; set; }

        public string? Description { get; set; }

        public Visibility Visibility { get; set; } = Visibility.Private;
    }
}