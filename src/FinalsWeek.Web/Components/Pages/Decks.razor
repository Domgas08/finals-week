@page "/decks"
@rendermode InteractiveServer
@using FinalsWeek.Core
@using FinalsWeek.Application
@inject IDeckStore DeckStore

<PageTitle>Deck'ai</PageTitle>

<h1>Mano deck'ai</h1>

<div class="mb-4">
    <input @bind="newTitle" placeholder="Pavadinimas" />
    <input @bind="newCourseCode" placeholder="Kurso kodas (nebūtina)" />
    <button @onclick="CreateDeck" disabled="@saving">
        @(saving ? "Kuriamas..." : "Sukurti")
    </button>
</div>

@if (error is not null)
{
    <p style="color: red">@error</p>
}

@if (isLoading)
{
    <p>Kraunasi deck'ai...</p>
}
else if (decks.Count == 0)
{
    <p>Kol kas neturite nė vieno deck'o. Sukurkite pirmą.</p>
}
else
{
    <ul>
        @foreach (var deck in decks)
        {
            <li>
                <a href="@($"/decks/{deck.Id}")">
                    <strong>@deck.Title</strong>
                </a>
                @if (deck.CourseCode is not null)
                {
                    <span> — @deck.CourseCode</span>
                }

                <a class="ms-2" href="@($"/decks/{deck.Id}/questions/add")">
                    Add question
                </a>

                <span class="ms-2">
                    Questions: @deck.Questions.Count
                </span>
            </li>
            
        }
    </ul>
}

@code {
    private IReadOnlyList<Deck> decks = [];
    private string newTitle = string.Empty;
    private string newCourseCode = string.Empty;
    private string? error;
    private bool isLoading = true;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        decks = await DeckStore.GetAllAsync();
        isLoading = false;
    }

    private async Task CreateDeck()
    {
        if (saving)
        {
            return;
        }

        error = null;
        saving = true;

        try
        {
            var courseCode = string.IsNullOrWhiteSpace(newCourseCode)
                ? null
                : newCourseCode.Trim();

            var deck = new Deck(newTitle, courseCode: courseCode);
            await DeckStore.AddAsync(deck);

            newTitle = string.Empty;
            newCourseCode = string.Empty;
            decks = await DeckStore.GetAllAsync();
        }
        catch (ArgumentException ex)
        {
            error = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}