@page "/register"
@using Microsoft.AspNetCore.Identity
@using FinalsWeek.Application
@inject UserManager<AppUser> UserManager

<h1>Register</h1>

<EditForm Model="model" OnValidSubmit="HandleRegister" FormName="register">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <InputText class="form-control" @bind-Value="model.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Password</label>
        <InputText type="password" class="form-control" @bind-Value="model.Password" />
    </div>
    <button type="submit" class="btn btn-primary">Register</button>
</EditForm>

@if (success)
{
    <p class="text-success mt-3">Registered.</p>
}

@foreach (var error in errors)
{
    <p class="text-danger">@error</p>
}

@code {
    [SupplyParameterFromForm]
    private RegisterModel model { get; set; } = new();
    private List<string> errors = new();
    private bool success;

    private async Task HandleRegister()
    {
        errors.Clear();
        success = false;

        var user = new AppUser { UserName = model.Email, Email = model.Email };
        var result = await UserManager.CreateAsync(user, model.Password);
        if (result.Succeeded){
            success = true;
            }
        else{
            foreach (var error in result.Errors){
    errors.Add(error.Description);
    }
        }
    }

    private class RegisterModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }
}