@page "/study/{SessionId:guid}/summary"
@using FinalsWeek.Core
@using FinalsWeek.Application
@inject ISessionStore SessionStore
@inject IDeckStore DeckStore

<PageTitle>Session summary</PageTitle>

@if (summary is null)
{
    <h1>Summary not available</h1>
    <p>This session was not found or is not finished yet.</p>
    <a href="/history">Back to history</a>
}
else
{
    <h1>@deckTitle</h1>

    <p class="lead">
        @summary.TotalScore points,
        @summary.CorrectCount of @summary.TotalQuestions correct
        (@summary.PercentageCorrect%),
        in @FormattedElapsed
    </p>

    @foreach (var topic in summary.Topics)
    {
        <h2 class="h5 mt-4">@topic.Topic</h2>
        <p class="text-muted">@topic.CorrectCount / @topic.TotalCount correct</p>

        <table class="table">
            <thead>
                <tr>
                    <th>Question</th>
                    <th>Your answer</th>
                    <th>Correct answer</th>
                    <th>Points</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var result in topic.Results)
                {
                    <tr>
                        <td>@result.Prompt</td>
                        <td>@(result.StudentAnswer ?? "Skipped")</td>
                        <td>@result.CorrectAnswer</td>
                        <td>@result.Points</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a class="btn btn-primary" href="@($"/decks/{summary.DeckId}")">Back to deck</a>
    <a class="btn btn-link" href="/history">History</a>
}

@code {
    private SessionSummary? summary;
    private string deckTitle = string.Empty;

    [Parameter]
    public Guid SessionId { get; set; }

    private string FormattedElapsed => summary!.Elapsed.TotalHours >= 1
        ? summary.Elapsed.ToString(@"h\:mm\:ss")
        : summary.Elapsed.ToString(@"m\:ss");

    protected override void OnParametersSet()
    {
        var session = SessionStore.Find(SessionId);

        if (session is null || session.FinishedAt is null)
        {
            summary = null;
            return;
        }

        summary = SessionSummaryCalculator.Summarise(session);
        deckTitle = DeckStore.GetById(session.DeckId)?.Title ?? "Deleted deck";
    }
}