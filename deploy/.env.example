# Copy this file to deploy/.env on the server and fill it in.
# deploy/.env is ignored by git. Never commit it.

# Token of the Cloudflare Tunnel for this site (see docs/deploy.md, step 1).
# It is the long string after "--token" in the command Cloudflare shows you.
TUNNEL_TOKEN=

# Database password. Use letters and digits only, because it goes into a
# connection string. Generate one with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional. These defaults are fine.
POSTGRES_USER=finalsuser
POSTGRES_DB=finals-week
