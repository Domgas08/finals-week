# Runs deploy/auto-update.sh once. Started every minute by finals-week-update.timer.
# Install: see "Automatic updates" in docs/deploy.md.

[Unit]
Description=Deploy new commits of Finals Week
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/usr/bin/bash /home/ubuntu/projects/finals-week/deploy/auto-update.sh
# A Docker build can take a few minutes.
TimeoutStartSec=20min
